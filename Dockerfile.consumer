# Build stage
FROM golang:1.24-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /bin/consumer ./cmd/consumer

# Runtime stage
FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 consumer
USER consumer

COPY --from=build /bin/consumer /usr/local/bin/consumer

ENTRYPOINT ["consumer"]
