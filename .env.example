# Chain preset: ethereum | polygon | arbitrum | optimism | base
# Selecting a chain seeds RPC_URL, CHAIN_ID, CONFIRMATIONS, POLL_INTERVAL,
# USE_FINALIZED and BATCH_SIZE with sensible per-network defaults. Any
# variable below still overrides its preset value. Run one instance per
# chain, each pointed at its own DATABASE_URL.
CHAIN=polygon

# Postgres connection string (one database per chain)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/polygon_indexer?sslmode=disable

# JSON-RPC endpoint. Preset default is a public node; use a provider
# (Alchemy/Infura/QuickNode) for real indexing throughput. Must support
# eth_getLogs, and the `finalized` tag when USE_FINALIZED=true.
# RPC_URL=https://polygon.drpc.org

# Override the preset chain id if needed (Ethereum = 1, Polygon = 137)
# CHAIN_ID=137

# First block to index on a fresh database. 0 = start at the current
# safe head (no historical backfill).
START_BLOCK=0

# Safe-head strategy:
#   USE_FINALIZED=true  -> index only up to the `finalized` block tag
#                          (true PoS finality; default for ethereum/L2s)
#   USE_FINALIZED=false -> index CONFIRMATIONS blocks behind head
#                          (default for polygon)
# USE_FINALIZED=false

# Blocks behind head considered safe when USE_FINALIZED=false.
# CONFIRMATIONS=64

# Max block span per eth_getLogs call. Preset-defaulted (Ethereum L1 is
# log-dense, so its preset uses a smaller span). Public RPCs often cap
# this; lower it if you see "block range too large" errors.
# BATCH_SIZE=500

# Cap on blocks advanced per poll cycle (bounds memory during backfill)
MAX_BLOCKS_PER_CYCLE=5000

# Parallel getLogs / header fetches per cycle
FETCH_CONCURRENCY=4

# Blocks to rewind when a reorg deeper than CONFIRMATIONS is detected
REORG_REWIND=256

# Delay between poll cycles once caught up (Polygon block time is ~2s)
POLL_INTERVAL=2s

# Timeout per RPC call
RPC_TIMEOUT=30s

# HTTP listen address for API + metrics
LISTEN_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info
