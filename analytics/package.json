{
  "name": "evm-analytics",
  "version": "1.0.0",
  "description": "TypeScript analytics service consuming the EVM indexer's Redis event stream: portfolios, token/pool leaderboards, live WebSocket feed",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["evm", "blockchain", "analytics", "event-driven", "redis-streams"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.17.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
