# Redis holding the indexer's event stream
REDIS_URL=redis://localhost:6379/0

# Stream key the Go indexer publishes to (must match its STREAM_NAME)
STREAM_NAME=evm.events

# Consumer group; replicas sharing a group load-balance the stream
CONSUMER_GROUP=analytics

# Unique per replica (defaults to analytics-<pid>)
# CONSUMER_NAME=analytics-1

# HTTP + WebSocket port
PORT=8090

# debug | info | warn | error
LOG_LEVEL=info
